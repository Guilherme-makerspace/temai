<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Filter Recipes</title>
</head>
<body>
    <h1>Filter Recipes</h1>

    <form action="/recipe/filter" method="GET">
        <div>
            <label for="category">Category:</label>
            <input type="text" id="category" name="category" value="<%= locals.category || '' %>" placeholder="e.g. Seafood, Beef">
        </div>

        <br>

        <div>
            <label for="ingredient">Main Ingredient:</label>
            <input type="text" id="ingredient" name="ingredient" value="<%= locals.ingredient || '' %>" placeholder="e.g. Chicken, Garlic">
        </div>

        <br>

        <div>
            <label for="area">Area / Cuisine:</label>
            <input type="text" id="area" name="area" value="<%= locals.area || '' %>" placeholder="e.g. Italian, Mexican, Canadian">
        </div>

        <br>

        <button type="submit">Filter</button>
    </form>

    <hr>

    <!-- Resultados -->
    <% if (Array.isArray(locals.recipes) && recipes.length > 0) { %>
        <h2>Results:</h2>
        <ul>
            <% recipes.forEach(recipe => { %>
                <li>
                    <h3><%= recipe.strMeal %></h3>
                    <img src="<%= recipe.strMealThumb %>" alt="<%= recipe.strMeal %>" width="150">
                </li>
            <% }) %>
        </ul>
    <% } else if (Array.isArray(locals.recipes) && recipes.length === 0) { %>
        <p>No recipes found matching these criteria.</p>
    <% } %>
</body>
</html>