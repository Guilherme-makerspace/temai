<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Tem Aí</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial Black', 'Segoe UI', Arial, sans-serif;
            background-color: #f5efe0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px;
        }

        .card {
            background: #ffffff;
            border: 4px solid #111111;
            border-radius: 12px;
            box-shadow: 8px 8px 0 #111111;
            width: 100%;
            max-width: 420px;
            padding: 36px 32px;
        }

        .logo {
            font-size: 26px;
            color: #111111;
            text-align: center;
            margin-bottom: 6px;
            letter-spacing: 1px;
        }

        .logo span {
            color: #e63946;
        }

        .subtitle {
            font-family: Verdana, Arial, sans-serif;
            font-size: 13px;
            color: #666666;
            text-align: center;
            margin-bottom: 28px;
        }

        .field {
            margin-bottom: 20px;
        }

        .field label {
            display: block;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #111111;
            margin-bottom: 6px;
        }

        .field input {
            width: 100%;
            padding: 12px 14px;
            font-family: Verdana, Arial, sans-serif;
            font-size: 15px;
            background: #faf7f0;
            border: 3px solid #111111;
            border-radius: 8px;
            color: #111111;
            outline: none;
            transition: box-shadow 0.15s ease;
        }

        .field input:focus {
            box-shadow: 4px 4px 0 #111111;
            background: #ffffff;
        }

        .btn-primary {
            width: 100%;
            margin-top: 8px;
            padding: 14px;
            font-family: 'Arial Black', Arial, sans-serif;
            font-size: 16px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #111111;
            background: #ffd166;
            border: 3px solid #111111;
            border-radius: 8px;
            box-shadow: 5px 5px 0 #111111;
            cursor: pointer;
            transition: transform 0.1s ease, box-shadow 0.1s ease;
        }

        .btn-primary:hover {
            transform: translate(2px, 2px);
            box-shadow: 3px 3px 0 #111111;
        }

        .btn-primary:active {
            transform: translate(5px, 5px);
            box-shadow: 0 0 0 #111111;
        }

        .footer {
            text-align: center;
            margin-top: 24px;
            font-family: Verdana, Arial, sans-serif;
            font-size: 13px;
            color: #555555;
        }

        .footer a {
            color: #111111;
            font-weight: bold;
            text-decoration: none;
            border-bottom: 2px solid #e63946;
        }

        .footer a:hover {
            color: #e63946;
        }
    </style>
</head>
<body>
    <div class="card">
        <h1 class="logo">TEM <span>AÍ</span></h1>
        <p class="subtitle">Acesse sua conta</p>

        <form action="/user/login" method="POST">
            <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="voce@email.com" required>
            </div>

            <div class="field">
                <label for="password">Senha</label>
                <input type="password" id="password" name="password" placeholder="Sua senha" required>
            </div>

            <button type="submit" class="btn-primary">Entrar</button>
        </form>

        <p class="footer">
            Não tem conta? <a href="/user/signup">Cadastre-se</a>
        </p>
    </div>
</body>
</html>
